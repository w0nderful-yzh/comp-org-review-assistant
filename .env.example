POSTGRES_DB=comp_org_review
POSTGRES_USER=comp_org
POSTGRES_PASSWORD=comp_org_dev_password
POSTGRES_PORT=5432

# Chroma is exposed on 8001 so FastAPI can use 8000 during local development.
CHROMA_PORT=8001

DATABASE_URL=postgresql+psycopg://comp_org:comp_org_dev_password@localhost:5432/comp_org_review
CHROMA_URL=http://localhost:8001

# Optional. Required only for AI draft generation.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT=45

# JWT 认证配置
SECRET_KEY=change-me-in-production-use-a-random-string
TOKEN_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440
