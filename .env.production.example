POSTGRES_DB=comp_org_review
POSTGRES_USER=comp_org
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Use ":80" for a temporary HTTP-only server by IP.
# Use "review.example.com" after DNS points to the server; Caddy will request HTTPS automatically.
PUBLIC_SITE_ADDRESS=:80
CORS_ORIGINS=["http://localhost","http://127.0.0.1"]

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_ENABLED=true
AI_REQUEST_TIMEOUT=45

# The production compose file mounts ./materials to /materials.
COURSEWARE_PDF_DIR=/materials/courseware-pdfs

SECRET_KEY=replace-with-a-long-random-secret
TOKEN_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440
